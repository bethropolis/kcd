[Unit]
Description=kcd — Headless KDE Connect Daemon
Documentation=https://github.com/bethropolis/kcd
# Wait for the graphical session: the compositor exports WAYLAND_DISPLAY into
# the systemd user manager at startup, and kcd's clipboard plugin probes the
# Wayland socket to spawn wl-copy/wl-paste. Starting at default.target means
# kcd boots before the compositor and misses the display environment.
After=network-online.target graphical-session.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
# sd_notify: systemd waits for the daemon to send READY=1 before marking
# the unit as started. This ensures dependent services and the Wants= chain
# work correctly. The daemon calls sd_notify(READY=1) after all subsystems
# (TCP listener, IPC socket, discovery) are fully initialised.
Type=notify
NotifyAccess=main

# %h expands to the user's home directory.
# Matches the binary installed by scripts/install.sh.
ExecStart=%h/.local/bin/kcd daemon

# Graceful shutdown: send SIGTERM and give the daemon up to 10 s to finish
# in-progress file transfers before SIGKILL.
KillMode=mixed
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# IPC socket directory, created automatically by systemd under $XDG_RUNTIME_DIR.
RuntimeDirectory=kcd
RuntimeDirectoryMode=0700

# ── Process hardening ─────────────────────────────────────────────────────────
# Namespace-based hardening (ProtectSystem, PrivateTmp, etc.) is intentionally
# omitted — unprivileged user services cannot reliably set up mount namespaces,
# which would cause startup failures on many distributions.
#
# NOTE: NoNewPrivileges is intentionally omitted because fusermount3 (setuid
# root) is required for sshfs FUSE mounts. Enabling it would block SFTP
# mounting with "fusermount3: mount failed: Operation not permitted".
MemoryMax=128M
TasksMax=64

# kcd needs the real network stack for UDP broadcast and KDE Connect TCP.
PrivateNetwork=false

[Install]
WantedBy=graphical-session.target
