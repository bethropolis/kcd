// ─── kcd module — add "custom/kcd" to your modules-right (or wherever) ───────
//
// In your waybar/config.jsonc:
//
//   "modules-right": ["custom/kcd", "clock", ...]
//
// The script connects persistently to the kcd daemon socket.
// restart-interval must be 0 — otherwise Waybar kills the connection every N seconds.
//

  "custom/kcd": {
    "exec": "~/.config/waybar/scripts/kcd-waybar.sh",
    "return-type": "json",
    "format": "{}",
    "on-click": "id=$(kcd devices --connected --json | jq -r '.[0].id // empty'); [ -n \"$id\" ] && kcd ping \"$id\"",
    "on-click-right": "foot -e kcd devices --paired",
    "restart-interval": 0
  },
